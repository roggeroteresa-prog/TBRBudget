# Copia questo file in .env (nella root del progetto) e inserisci la tua API key.
# Il file .env NON deve mai essere committato (vedi .gitignore).

OPENAI_API_KEY=...

# Back end Node.js
PORT=...
CHROMA_URL=...
DATA_AGENT_URL=...
# Chiave per firmare i token di sessione (JWT). Genera una stringa lunga e
# casuale, es. con `openssl rand -hex 32` — non riusare mai un valore d'esempio.
JWT_SECRET=...

# Data agent Python
DATA_AGENT_PORT=...
